# Copy to .env and fill in. Nothing here is committed.

# --- Google sign-in (required for real Gmail) ---------------------------------
# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# OAuth client ID → Application type "Web application".
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the app is served. Dev server: http://localhost:5173. Production: http://localhost:8787
APP_URL=http://localhost:5173

# --- Sign-in and roles ----------------------------------------------------------
# Workspace owner(s): always admin, cannot be demoted or removed. Comma-separated for several.
# Everyone else signs in only after an admin adds them under Team & roles.
ADMIN_EMAIL=winterhot223@gmail.com

# --- AI classification (optional) ---------------------------------------------
# With a key, each recruiter email is classified and summarized by Claude.
# Without one, keyword rules do the classification (less nuanced, still useful).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Tuning (optional) --------------------------------------------------------
# Gmail search used on every sync
# GMAIL_SYNC_QUERY=newer_than:60d -in:spam -in:trash -category:promotions -category:social
# Keep only mail with a job-search signal (interview, recruiter, application, …). Set off to keep everything.
# GMAIL_JOB_FILTER=on
# GMAIL_MAX_MESSAGES=150
# Encrypts stored tokens and signs sign-in cookies; generated into server/data/secret.key when empty
# TOKEN_SECRET=
# Where account and mail caches are written
# IFLOW_DATA_DIR=server/data
# Upstash Redis instead of files (required on Vercel; its Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Development ---------------------------------------------------------------
# Fake Google: sign-in succeeds instantly and the mailbox is the demo data, in real Gmail format.
# GOOGLE_MOCK=1
