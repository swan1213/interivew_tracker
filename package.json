{
  "name": "interviewflow-ai",
  "private": true,
  "version": "0.1.0",
  "description": "InterviewFlow AI: a unified job-search inbox that classifies recruiter email, extracts interview details, drafts replies and keeps your application pipeline and calendar in sync.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx server/src/index.ts",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build:vercel": "npm run build && node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
